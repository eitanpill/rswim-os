{
  "name": "@rswim/mobile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Aqua Swim in the App Store and Google Play: a Capacitor shell that loads the web app (store launch, stage 5)",
  "scripts": {
    "sync": "node scripts/site-url.mjs && cap sync",
    "sync:android": "node scripts/site-url.mjs && cap sync android",
    "sync:ios": "node scripts/site-url.mjs && cap sync ios",
    "assets": "capacitor-assets generate --iconBackgroundColor '#1f7fb8' --splashBackgroundColor '#1f7fb8' --splashBackgroundColorDark '#0b2a3d' --ios --android",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/ios": "8.6.2",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "8.6.2",
    "@types/node": "^22.0.0",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
