<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Links to Aqua Swim open the app (Universal Links, verified by /.well-known/apple-app-site-association). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:app.aqua-swim.co.il</string>
		<string>applinks:staging.aqua-swim.co.il</string>
		<string>applinks:*.aqua-swim.co.il</string>
	</array>
</dict>
</plist>
