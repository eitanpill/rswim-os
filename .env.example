# Copy to .env and fill in. Never commit real values.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 32 random bytes, base64: openssl rand -base64 32
RSWIM_MASTER_KEY=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Local only: enables /dev/login role switcher (never in production)
RSWIM_DEV_AUTH=0
# Divers' documents (insurance policy, doctor's note): local disk for dev/demo, Supabase Storage once it exists
RSWIM_FILES_FAKE=0
RSWIM_FILES_DIR=
RSWIM_FILES_BUCKET=dive-documents
# The web app's public address, for payment links sent to customers (worker)
RSWIM_PUBLIC_URL=
# Local/demo only: every connected processor runs as the demo processor (never in production)
RSWIM_PAYMENTS_SANDBOX=0
# A database per school (docs/TENANT-DATABASES.md), worker only. Never commit real values.
SUPABASE_ACCESS_TOKEN=
SUPABASE_ORG_SLUG=
SUPABASE_REGION=eu-central-1
SUPABASE_INSTANCE_SIZE=
RSWIM_TENANT_ADMIN_URL=
